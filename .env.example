# Canonical site URL used by metadataBase, sitemap.xml, and robots.txt.
# Defaults to https://www.jengerluxurious.com if unset.
NEXT_PUBLIC_SITE_URL=https://www.jengerluxurious.com

# Square — primary checkout (same processor as https://www.jengerluxurious.com)
# Leave blank for a local build. Do not invent live keys.
# Without this URL, checkout shows a config message and /api/square-checkout
# returns 503. Payment is required — there is no hold / pay-later path.

# Required to collect payment: hosted Square Online checkout / Payment Link
NEXT_PUBLIC_SQUARE_CHECKOUT_URL=

# Optional Square Web Payments placeholders (not required to build)
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=

# Server-only Square access token — never commit a real value
# SQUARE_ACCESS_TOKEN=

# Parked: Stripe is not on the checkout path
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional: Capacitor/Android API host
# NEXT_PUBLIC_API_BASE_URL=

# Optional item-request alerts
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
