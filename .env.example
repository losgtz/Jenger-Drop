# Canonical site URL used by metadataBase, sitemap.xml, robots.txt, and OG.
# Until DNS for jengerluxurious.com points at this Vercel app, keep this as
# the live Next host so Google is not told the Square/Weebly site is canonical.
NEXT_PUBLIC_SITE_URL=https://jenger-drop.vercel.app

# Set to true ONLY after DNS for www.jengerluxurious.com points at Vercel.
# Until then, a leftover NEXT_PUBLIC_SITE_URL of the Square site is ignored.
# NEXT_PUBLIC_USE_CUSTOM_DOMAIN=true

# Stripe — primary checkout
# Leave blank for a local build. Do not invent live keys.
# Without STRIPE_SECRET_KEY or NEXT_PUBLIC_STRIPE_PAYMENT_LINK,
# checkout shows a config message and /api/stripe-checkout returns 503.

# Required for Checkout Sessions (server-only — never commit a real value)
# STRIPE_SECRET_KEY=

# Optional public key (Checkout Session redirect does not require it)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional hosted Payment Link fallback if Checkout Sessions are not set
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

# Optional: Capacitor/Android API host
# NEXT_PUBLIC_API_BASE_URL=

# Optional item-request alerts
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
